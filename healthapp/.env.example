# HealthGuide AI - Environment Variables Template
# Copy this to .env for local development
# Add these values in the Vercel Dashboard for production deployment

# Gemini API Key (Optional if only using Lyzr)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Lyzr AI Credentials (Required)
VITE_LYZR_API_KEY=your_lyzr_api_key_here
VITE_LYZR_AGENT_ID=your_lyzr_agent_id_here
VITE_LYZR_USER_ID=your_lyzr_user_id_here
